# ShopSphere Production & Local Environment Configuration

# Security
SECRET_KEY=django-insecure-replace-this-with-a-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Database Configuration
# Supported options: 'mysql' or 'sqlite'
# If DB_ENGINE=mysql and connection fails, the application automatically falls back to SQLite3 safely.
DB_ENGINE=sqlite
DB_NAME=shopsphere_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Payment Gateway (Razorpay Test Mode)
RAZORPAY_KEY_ID=rzp_test_shopsphere123
RAZORPAY_KEY_SECRET=secret_shopsphere456
